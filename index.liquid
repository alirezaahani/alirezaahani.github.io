<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "head.liquid" %}
  </head>
  <body>
    <header>
      {% include "header.liquid" %}
    </header>
    <main>
      <section>
        <h2>Blog posts: </h2>
        {% for post in collections.posts.pages %}
        <article>
          <h3><a href="{{ post.permalink }}">{{ post.title }}</a></h3>
          <h4><time pubdate="pubdate">{{ post.published_date | date: "%Y/%m/%d" }}</time> - {% if post.categories.size > 0 %}{{ post.categories | join: ", " }}{% endif %}</h4>
          <p>
            {{ post.description }}
          </p>
        </article>
        {% endfor %}
      </section>

      <section>
        <h2>Contact:</h2> 
        <ul>
          <li>Email: alirezaahani1386 [at] gmail [dot] com</li>
          <li>Telegram: @alireza_ahani</li>
        </ul>
      </section>
    </main>
    <footer>
      {% include "footer.liquid" %}
    </footer>
  </body>
</html>
